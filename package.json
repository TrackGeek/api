{
  "name": "trackgeek-api",
  "scripts": {
    "types": "tsc --noEmit",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "check": "biome check",
    "check:fix": "biome check --write",
    "format": "biome format",
    "format:fix": "biome format --write",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "db:run": "npm run prisma:migrate && npm run prisma:generate && npm run prisma:seed",
    "test:unit": "vitest run --printConsoleTrace=true --silent=false",
    "test:unit:watch": "vitest",
    "test:unit:ui": "vitest --ui",
    "test:unit:cov": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:load": "k6 run test/load/load.ts",
    "dev": "NODE_ENV=development nest start --watch",
    "build": "nest build",
    "start": "NODE_ENV=production node dist/src/main"
  },
  "dependencies": {
    "@faker-js/faker": "^10.3.0",
    "@nestjs-redis/client": "^1.0.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.12",
    "@nestjs/swagger": "^11.2.4",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@scalar/nestjs-api-reference": "^1.0.29",
    "@thallesp/nestjs-better-auth": "^2.4.0",
    "@willsoto/nestjs-prometheus": "^6.0.2",
    "axios": "1.13.5",
    "bcrypt": "^6.0.0",
    "better-auth": "^1.4.18",
    "bullmq": "^5.67.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "emoji-regex": "^10.6.0",
    "graphql": "^16.12.0",
    "handlebars": "^4.7.9",
    "helmet": "^8.1.0",
    "lodash": "^4.17.23",
    "multer": "2.1.1",
    "nestjs-resend": "^1.1.0",
    "pg": "^8.16.3",
    "prom-client": "^15.1.3",
    "redis": "^5.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^20.4.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@playwright/test": "^1.58.2",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/k6": "^1.6.0",
    "@types/lodash": "^4.17.23",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^4.0.18",
    "globals": "^16.0.0",
    "prisma": "^7.2.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",

generator client {
  provider     = "prisma-client"
  output       = "./generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id
  name          String
  email         String
  emailVerified Boolean  @default(false)
  image         String?
  username      String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  profile          Profile?
  sessions         Session[]
  accounts         Account[]
  comments         Comment[]
  reactions        Reaction[]
  followers        Following[]      @relation("UserFollowers")
  following        Following[]      @relation("UserFollowing")
  feedEvents       FeedEvent[]
  animeWatches     AnimeWatch[]
  lists            List[]
  tvshowWatches    TVShowWatch[]
  movieWatches     MovieWatch[]
  bookReads        BookRead[]
  mangaReads       MangaRead[]
  animeProgresses  AnimeProgress[]
  mangaProgresses  MangaProgress[]
  tvshowProgresses TVShowProgress[]
  movieProgresses  MovieProgress[]
  gameProgresses   GameProgress[]
  bookProgresses   BookProgress[]
  animeReviews     AnimeReview[]
  mangaReviews     MangaReview[]
  tvshowReviews    TVShowReview[]
  movieReviews     MovieReview[]
  gameReviews      GameReview[]
  bookReviews      BookReview[]
  favorites        Favorite[]
  userMedals       UserMedal[]

  @@unique([email])
}

model Profile {
  id        String   @id @default(uuid())
  userId    String   @unique
  color     String?  @default("#10b981")
  language  String?  @default("en-US")
  timezone  String?
  about     String?  @default("Hello! I'm using TrackGeek.")
  bannerUrl String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  profilesComments ProfileComment[]
}

model Medal {
  id          String   @id @default(uuid())
  name        String
  description String
  imageUrl    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userMedals UserMedal[]
}

model UserMedal {
  id        String   @id @default(uuid())
  userId    String
  medalId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  medal Medal @relation(fields: [medalId], references: [id], onDelete: Cascade)

  @@unique([userId, medalId])
}

model Following {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  follower  User @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  commentsReactions CommentReaction[]
  gamesComments     GameComment[]
  profilesComments  ProfileComment[]
  bookComments      BookComment[]
  animeComments     AnimeComment[]
  mangaComments     MangaComment[]
  tvShowComments    TVShowComment[]
  movieComments     MovieComment[]
}

model Reaction {
  id        String   @id @default(uuid())
  emoji     String
  userId    String
  createdAt DateTime @default(now())

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  commentsReactions CommentReaction[]
}

model CommentReaction {
  id         String @id @default(uuid())
  commentId  String
  reactionId String

  comment  Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reaction Reaction @relation(fields: [reactionId], references: [id], onDelete: Cascade)

  @@unique([commentId, reactionId])
}

model GameComment {
  id        String @id @default(uuid())
  gameId    String
  commentId String

  game    Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([gameId, commentId])
}

model BookComment {
  id        String @id @default(uuid())
  bookId    String
  commentId String

  book    Book    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([bookId, commentId])
}

model AnimeComment {
  id        String @id @default(uuid())
  animeId   String
  commentId String

  anime   Anime   @relation(fields: [animeId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([animeId, commentId])
}

model MangaComment {
  id        String @id @default(uuid())
  mangaId   String
  commentId String

  manga   Manga   @relation(fields: [mangaId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([mangaId, commentId])
}

model TVShowComment {
  id        String @id @default(uuid())
  tvShowId  String
  commentId String

  tvShow  TVShow  @relation(fields: [tvShowId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([tvShowId, commentId])
}

model MovieComment {
  id        String @id @default(uuid())
  movieId   String
  commentId String

  movie   Movie   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([movieId, commentId])
}

model ProfileComment {
  id        String @id @default(uuid())
  profileId String
  commentId String

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([profileId, commentId])
}

enum FeedEventType {
  NewComment
  NewFollower
}

model FeedEvent {
  id        String        @id @default(uuid())
  type      FeedEventType
  userId    String
  metadata  Json?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Game {
  id                    String    @id @default(uuid())
  igdbId                Int       @unique
  ageRatings            Json?
  aggregatedRating      Float?
  aggregatedRatingCount Int?
  alternativeNames      Json?
  artworks              Json?
  checksum              String?
  bundles               Json?
  collections           Json?
  coverUrl              String?
  dlcs                  Json?
  expandedGames         Json?
  expansions            Json?
  externalGames         Json?
  firstReleaseDate      DateTime?
  forks                 Json?
  franchise             Json?
  franchises            Json?
  gameEngines           Json?
  gameLocalizations     Json?
  gameModes             Json?
  gameStatus            Json?
  gameType              Json?
  genres                Json?
  hypes                 Int?
  involvedCompanies     Json?
  keywords              Json?
  multiplayerModes      Json?
  name                  String?
  parentGame            Json?
  platforms             Json?
  playerPerspectives    Json?
  ports                 Json?
  rating                Float?
  ratingCount           Int?
  releaseDates          Json?
  remakes               Json?
  remasters             Json?
  screenshots           Json?
  similarGames          Json?
  slug                  String    @unique
  standaloneExpansions  Json?
  storyline             Json?
  summary               String?
  totalRating           Float?
  totalRatingCount      Int?
  versionParent         Json?
  versionTitle          Json?
  videos                Json?
  lastRefreshedAt       DateTime  @default(now())
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  gamesComments  GameComment[]
  listGames      ListGame[]
  gameProgresses GameProgress[]
  gameReviews    GameReview[]
  favorites      Favorite[]
}

model Book {
  id                       String    @id @default(uuid())
  alternativeTitles        Json?
  audioSeconds             Int?
  bookCategoryId           Int?
  bookStatus               Json?
  bookStatusId             Int?
  canonical                Json?
  canonicalId              Int?
  compilation              Boolean?
  curationStatus           Int?
  defaultAudioEdition      Json?
  defaultAudioEditionId    Int?
  defaultCoverEedition     Json?
  defaultCoverEditionId    Int?
  defaultEbookEdition      Json?
  defaultEbookEditionId    Int?
  defaultPhysicalEdition   Json?
  defaultPhysicalEditionId Int?
  description              String?
  editionsCount            Int?
  featuredBookSeries       Json?
  featuredBookSeriesId     Int?
  headerImageId            Int?
  headline                 String?
  hardcoverId              Int       @unique
  image                    Json?
  imageId                  Int?
  links                    Json?
  literaryTypeId           Int?
  pages                    Int?
  releaseDate              DateTime?
  releaseYear              Int?
  slug                     String
  state                    String?
  title                    String
  lastRefreshedAt          DateTime  @default(now())
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  bookComments   BookComment[]
  listBooks      ListBook[]
  bookReads      BookRead[]
  bookProgresses BookProgress[]
  bookReviews    BookReview[]
  favorites      Favorite[]
}

model Anime {
  id               String   @id @default(uuid())
  malId            Int      @unique
  url              String
  imageUrl         String?
  trailer          Json?
  titles           Json?
  type             String?
  source           String?
  numberOfEpisodes Int?
  status           String?
  aired            Json?
  duration         String?
  rating           String?
  rank             Int?
  popularity       Int?
  synopsis         String?
  background       String?
  season           String?
  year             Int?
  broadcast        Json?
  producers        Json?
  licensors        Json?
  studios          Json?
  genres           Json?
  explicitGenres   Json?
  themes           Json?
  demographics     Json?
  relations        Json?
  theme            Json?
  external         Json?
  characters       Json?
  cast             Json?
  videos           Json?
  lastRefreshedAt  DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  animeComments   AnimeComment[]
  animeWatches    AnimeWatch[]
  listAnimes      ListAnime[]
  animeProgresses AnimeProgress[]
  animeReviews    AnimeReview[]
  favorites       Favorite[]
}

model Manga {
  id               String   @id @default(uuid())
  malId            Int      @unique
  url              String
  imageUrl         String?
  titles           Json?
  type             String?
  numberOfChapters Int?
  numberOfVolumes  Int?
  status           String?
  publishing       Boolean?
  published        Json?
  rank             Int?
  popularity       Int?
  synopsis         String?
  authors          Json?
  serializations   Json?
  genres           Json?
  explicitGenres   Json?
  themes           Json?
  demographics     Json?
  relations        Json?
  external         Json?
  characters       Json?
  lastRefreshedAt  DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  mangaComments   MangaComment[]
  listMangas      ListManga[]
  mangaReads      MangaRead[]
  mangaProgresses MangaProgress[]
  mangaReviews    MangaReview[]
  favorites       Favorite[]
}

model TVShow {
  id                  String    @id @default(uuid())
  tmdbId              Int       @unique
  createdBy           Json?
  episodeRuntime      Int[]
  firstAirDate        DateTime?
  genres              Json?
  homepage            String?
  inProduction        Boolean?
  languages           String[]
  lastAirDate         DateTime?
  lastEpisodeToAir    Json?
  name                String?
  nextEpisodeToAir    String?
  networks            Json?
  numberOfEpisodes    Int?
  numberOfSeasons     Int?
  originCountry       String[]
  originalLanguage    String?
  originalName        String?
  popularity          Int?
  posterPath          String?
  productionCompanies Json?
  productionCountries Json?
  seasons             Json?
  status              String?
  tagline             String?
  type                String?
  cast                Json?
  crew                Json?
  lastRefreshedAt     DateTime  @default(now())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tvShowComments   TVShowComment[]
  listTVShows      ListTVShow[]
  tvshowWatches    TVShowWatch[]
  tvshowProgresses TVShowProgress[]
  tvshowReviews    TVShowReview[]
  favorites        Favorite[]
}

model Movie {
  id                  String    @id @default(uuid())
  tmdbId              Int       @unique
  imdbId              String?
  belongsToCollection Json?
  budget              Int?
  genres              Json?
  homepage            String?
  originalLanguage    String?
  originalTitle       String?
  overview            String?
  popularity          Int?
  posterPath          String?
  productionCompanies Json?
  productionCountries Json?
  releaseDate         DateTime?
  revenue             Int?
  runtime             Int?
  spokenLanguages     Json?
  status              String?
  title               String?
  videos              Json?
  cast                Json?
  crew                Json?
  posterUrl           String?
  lastRefreshedAt     DateTime  @default(now())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  movieComments   MovieComment[]
  listMovies      ListMovie[]
  movieWatches    MovieWatch[]
  movieProgresses MovieProgress[]
  movieReviews    MovieReview[]
  favorites       Favorite[]
}

enum WatchStatus {
  Watching
  Completed
  Paused
  Dropped
  Planning
}

model AnimeWatch {
  id          String      @id @default(uuid())
  season      Int
  episode     Int
  status      WatchStatus
  userId      String
  animeId     String
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user  User  @relation(fields: [userId], references: [id])
  anime Anime @relation(fields: [animeId], references: [id])

  @@unique([userId, animeId])
  @@index([userId])
}

model TVShowWatch {
  id          String      @id @default(uuid())
  season      Int
  episode     Int
  status      WatchStatus
  userId      String
  tvShowId    String
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  tvShow TVShow @relation(fields: [tvShowId], references: [id])

  @@unique([userId, tvShowId])
  @@index([userId])
}

model MovieWatch {
  id          String      @id @default(uuid())
  status      WatchStatus
  userId      String
  movieId     String
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user  User  @relation(fields: [userId], references: [id])
  movie Movie @relation(fields: [movieId], references: [id])

  @@unique([userId, movieId])
  @@index([userId])
}

enum ReadStatus {
  Reading
  Completed
  Paused
  Dropped
  Planning
}

model BookRead {
  id          String     @id @default(uuid())
  status      ReadStatus
  chapter     Int?
  volume      Int?
  userId      String
  bookId      String
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id])
  book Book @relation(fields: [bookId], references: [id])

  @@unique([userId, bookId])
  @@index([userId])
}

model MangaRead {
  id          String     @id @default(uuid())
  status      ReadStatus
  chapter     Int?
  volume      Int?
  userId      String
  mangaId     String
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user  User  @relation(fields: [userId], references: [id])
  manga Manga @relation(fields: [mangaId], references: [id])

  @@unique([userId, mangaId])
  @@index([userId])
}

enum ProgressStatus {
  Watching
  Playing
  Reading
  Completed
  Paused
  Dropped
  Planning
}

model AnimeProgress {
  id        String         @id @default(uuid())
  status    ProgressStatus
  userId    String
  animeId   String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user  User  @relation(fields: [userId], references: [id])
  anime Anime @relation(fields: [animeId], references: [id])

  @@unique([userId, animeId])
  @@index([userId])
}

model MangaProgress {
  id        String         @id @default(uuid())
  status    ProgressStatus

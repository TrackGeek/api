enum MissionMetric {
  EpisodesWatched
  ProgressCompleted
  ReviewsWritten
  FavoritesAdded
  ListsCreated
  ListItemsAdded
  UsersFollowed
  CommentsWritten
  LevelReached
  StreakReached
  ContentTypesReviewed
}

enum MissionTier {
  Bronze
  Silver
  Gold
  Platinum
}

model Mission {
  id          String        @id @default(uuid(7))
  key         String        @unique
  metric      MissionMetric
  contentType ContentType?
  target      Int
  xpReward    Int           @default(0)
  coinReward  Int           @default(0)
  cosmeticKey String?
  medalId     String?
  tier        MissionTier   @default(Bronze)
  position    Int           @default(0)

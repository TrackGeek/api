enum ListType {
  Anime
  Manga
  TVShow
  Movie
  Game
  Book
}

model List {
  id          String   @id @default(uuid())
  name        String
  description String?
  type        ListType
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id])
  listAnimes  ListAnime[]
  listMangas  ListManga[]
  listTVShows ListTVShow[]
  listMovies  ListMovie[]
  listGames   ListGame[]
  listBooks   ListBook[]
}

model ListAnime {
  id        String   @id @default(uuid())
  listId    String
  animeId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  list  List  @relation(fields: [listId], references: [id])
  anime Anime @relation(fields: [animeId], references: [id])

  @@unique([listId, animeId])
}

model ListManga {
  id        String   @id @default(uuid())
  listId    String
  mangaId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  list  List  @relation(fields: [listId], references: [id])
  manga Manga @relation(fields: [mangaId], references: [id])

  @@unique([listId, mangaId])
}

model ListTVShow {
  id        String   @id @default(uuid())
  listId    String
  tvShowId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  list   List   @relation(fields: [listId], references: [id])
  tvShow TVShow @relation(fields: [tvShowId], references: [id])

  @@unique([listId, tvShowId])
}

model ListMovie {
  id        String   @id @default(uuid())
  listId    String
  movieId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  list  List  @relation(fields: [listId], references: [id])
  movie Movie @relation(fields: [movieId], references: [id])

  @@unique([listId, movieId])
}

model ListGame {
  id        String   @id @default(uuid())
  listId    String
  gameId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  list List @relation(fields: [listId], references: [id])
  game Game @relation(fields: [gameId], references: [id])

  @@unique([listId, gameId])
}

model ListBook {
  id        String   @id @default(uuid())
  listId    String
  bookId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  list List @relation(fields: [listId], references: [id])
  book Book @relation(fields: [bookId], references: [id])

  @@unique([listId, bookId])
}

enum FavoriteType {
  Anime
  Manga
  TVShow
  Movie
  Game
  Book
}

model Favorite {
  id        String       @id @default(uuid())
  type      FavoriteType
  userId    String
  animeId   String?
  mangaId   String?
  tVShowId  String?
  movieId   String?
  gameId    String?
  bookId    String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user   User    @relation(fields: [userId], references: [id])
  anime  Anime?  @relation(fields: [animeId], references: [id])
  manga  Manga?  @relation(fields: [mangaId], references: [id])
  tvShow TVShow? @relation(fields: [tVShowId], references: [id])
  movie  Movie?  @relation(fields: [movieId], references: [id])
  game   Game?   @relation(fields: [gameId], references: [id])
  book   Book?   @relation(fields: [bookId], references: [id])
}

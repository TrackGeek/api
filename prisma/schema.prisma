enum CatchupMediaType {
  Anime
  Manga
  TvShow
  Game
}

enum ReleaseEventType {
  NewEpisodeReleased
  NewChapterReleased
  NewGameReleased
  SequelAdded
}

enum ReleaseSource {
  Tenrai
  Anilist
  Tmdb
  Igdb
}

enum CatchupRunStatus {
  Running
  Success
  Failed
}

model CatchupRun {
  id         String           @id @default(uuid(7))
  runDate    DateTime
  status     CatchupRunStatus @default(Running)
  stats      Json?
  error      String?
  startedAt  DateTime         @default(now())
  finishedAt DateTime?

  releaseEvents ReleaseEvent[]
  auditLogs     CatchupAuditLog[]

  @@index([runDate])
  @@index([status, startedAt])
}

model ReleaseEvent {
  id              String           @id @default(uuid(7))
  type            ReleaseEventType
  mediaType       CatchupMediaType
  source          ReleaseSource
  externalId      String
  idempotencyKey  String           @unique
  title           String
  unitNumber      Int?
  containerNumber Int?
  unitTitle       String?
  isAccessory     Boolean          @default(false)
  releaseAt       DateTime
  rawPayload      Json?
  runId           String?
  animeId         String?
  mangaId         String?
  tvShowId        String?
  gameId          String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  run                  CatchupRun?           @relation(fields: [runId], references: [id], onDelete: SetNull)
  anime                Anime?                @relation(fields: [animeId], references: [id], onDelete: Cascade)
  manga                Manga?                @relation(fields: [mangaId], references: [id], onDelete: Cascade)
  tvShow               TvShow?               @relation(fields: [tvShowId], references: [id], onDelete: Cascade)
  game                 Game?                 @relation(fields: [gameId], references: [id], onDelete: Cascade)
  notifications        Notification[]
  statusTransitionLogs StatusTransitionLog[]

  @@index([mediaType, releaseAt])
  @@index([releaseAt])
  @@index([animeId])
  @@index([mangaId])
  @@index([tvShowId])
  @@index([gameId])
}

model StatusTransitionLog {
  id             String           @id @default(uuid(7))
  userId         String
  mediaType      CatchupMediaType
  fromStatus     ProgressStatus
  toStatus       ProgressStatus
  reason         String
  releaseEventId String?
  createdAt      DateTime         @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  releaseEvent ReleaseEvent? @relation(fields: [releaseEventId], references: [id], onDelete: SetNull)

  @@unique([userId, releaseEventId])
  @@index([userId, createdAt])
}

model CatchupAuditLog {
  id        String   @id @default(uuid(7))
  action    String
  runId     String?
  metadata  Json?
  createdAt DateTime @default(now())

  run CatchupRun? @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([action, createdAt])
}


}

model GameProgress {
  id        String         @id @default(uuid())
  status    ProgressStatus
  userId    String
  gameId    String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id])
  game Game @relation(fields: [gameId], references: [id])


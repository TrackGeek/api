enum ListType {
  Anime
  Manga
  TVShow
  Movie
  Game
  Book
}

model List {
  id          String   @id @default(uuid(7))
  name        String
  description String?
  type        ListType
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  listItems  ListItem[]
  activities Activity[]

  @@unique([userId, name])
}

model ListItem {
  id       String  @id @default(uuid(7))
  listId   String
  position Int?
  animeId  String?
  mangaId  String?
  tvShowId String?
  movieId  String?
  gameId   String?
  bookId   String?

  list   List    @relation(fields: [listId], references: [id], onDelete: Cascade)
  anime  Anime?  @relation(fields: [animeId], references: [id], onDelete: Cascade)
  manga  Manga?  @relation(fields: [mangaId], references: [id], onDelete: Cascade)
  tvShow TvShow? @relation(fields: [tvShowId], references: [id], onDelete: Cascade)
  movie  Movie?  @relation(fields: [movieId], references: [id], onDelete: Cascade)
  game       Game?      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  book       Book?      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  activities Activity[]

  @@unique([listId, animeId])
  @@unique([listId, mangaId])
  @@unique([listId, tvShowId])
  @@unique([listId, movieId])
  @@unique([listId, gameId])
  @@unique([listId, bookId])
}

enum FavoriteType {
  Anime
  Manga
  TVShow
  Movie
  Game
  Book
}

model Favorite {
  id        String       @id @default(uuid(7))
  type      FavoriteType
  position  Int?
  userId    String
  animeId   String?
  mangaId   String?
  tvShowId  String?
  movieId   String?
  gameId    String?
  bookId    String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  anime  Anime?  @relation(fields: [animeId], references: [id], onDelete: Cascade)
  manga  Manga?  @relation(fields: [mangaId], references: [id], onDelete: Cascade)
  tvShow TvShow? @relation(fields: [tvShowId], references: [id], onDelete: Cascade)
  movie  Movie?  @relation(fields: [movieId], references: [id], onDelete: Cascade)
  game       Game?      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  book       Book?      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  activities Activity[]

  @@unique([userId, animeId])
  @@unique([userId, mangaId])
  @@unique([userId, tvShowId])
  @@unique([userId, movieId])
  @@unique([userId, gameId])
  @@unique([userId, bookId])
}

enum PaymentStatus {
  Pending
  Succeeded
  Failed
}

enum PaymentFrequency {
  OneTime
  Monthly
}

model Payment {
  id                       String           @id @default(uuid(7))
  name                     String
  value                    Int
  currency                 String
  status                   PaymentStatus
  frequency                PaymentFrequency
  stripeInvoiceUrl         String?
  stripeChargeId           String?
  stripePaymentIntentId    String?
  stripeSubscriptionId     String?
  stripeCheckoutSessionUrl String?
  stripeCheckoutSessionId  String?
  stripeCustomerId         String
  stripeProductId          String
  userId                   String
  expiredAt                DateTime?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([stripeCheckoutSessionId])
  @@index([userId, status, createdAt])
  @@index([stripeProductId])
}

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sign in to TrackGeek</title>
</head>
<body style="margin: 0; padding: 0; background-color: #0e0e12; font-family: Arial, sans-serif;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #0e0e12; padding: 48px 20px;">
    <tr>
      <td align="center">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width: 580px;">

          <!-- Logo -->
          <tr>
            <td align="center" style="padding-bottom: 32px;">
              <img src="https://i.imgur.com/W0moi0W.png" alt="TrackGeek" width="160" style="display: block; border: 0;" />
            </td>
          </tr>

          <!-- Card -->
          <tr>
            <td style="background-color: oklch(21% 0.006 285.885); border: 1px solid rgba(255,255,255,0.08); border-radius: 10px; overflow: hidden;">

              <!-- Green top bar -->
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                <tr>
                  <td style="background: linear-gradient(90deg, #10b981, #34d399); height: 4px; font-size: 0; line-height: 0;">&nbsp;</td>
                </tr>
              </table>

              <!-- Header -->
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                <tr>
                  <td align="center" style="padding: 40px 40px 32px 40px;">
                    <h1 style="margin: 0 0 10px 0; color: #ffffff; font-size: 26px; font-weight: 700; line-height: 1.25;">
                      Hello, {{ name }}!
                    </h1>
                    <p style="margin: 0 0 16px 0; color: #8b8b9e; font-size: 16px; line-height: 1.6;">
                      Click the button below to securely sign in to your account.
                    </p>
                    <span style="display: inline-block; background-color: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.08); border-radius: 20px; padding: 6px 14px; color: #8b8b9e; font-size: 12px;">
                      This link expires in <strong style="color: #ffffff;">5 minutes</strong>
                    </span>
                  </td>
                </tr>
              </table>

              <!-- CTA -->
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                <tr>
                  <td align="center" style="padding: 0 40px 28px 40px;">
                    <a href="{{ url }}" style="display: inline-block; background: linear-gradient(90deg, #10b981, #34d399); color: #ffffff; font-size: 15px; font-weight: 700; padding: 13px 32px; text-decoration: none; border-radius: 8px; letter-spacing: 0.3px;">
                      Sign in to TrackGeek →
                    </a>
                  </td>
                </tr>
              </table>

              <!-- Note -->
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                <tr>
                  <td style="padding: 0 40px 40px 40px;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: rgba(16,185,129,0.06); border: 1px solid rgba(16,185,129,0.15); border-radius: 8px;">
                      <tr>
                        <td style="padding: 14px 18px; color: #8b8b9e; font-size: 13px; line-height: 1.6;">
                          If you did not request this link, you can safely ignore this email.
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td align="center" style="padding-top: 28px;">
              <p style="margin: 0; color: #4a4a5a; font-size: 12px; line-height: 1.6;">
                © 2026 TrackGeek. All rights reserved.
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
